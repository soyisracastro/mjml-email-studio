<!-- Abacus header — include in <mj-head>:
     <mj-style>
       @media only screen and (max-width: 480px) {
         .header-subtitle div { text-align: left !important; }
         .header-subtitle br  { display: none !important; }
       }
     </mj-style>
-->
<mj-section background-color="#132175" padding="24px 32px">
  <mj-column width="60%">
    <mj-text
      font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
      font-size="11px"
      font-weight="700"
      color="rgba(255,255,255,0.5)"
      letter-spacing="1px"
      padding-bottom="3px"
    >
      TODOCONTA
    </mj-text>
    <mj-text
      font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
      font-size="24px"
      font-weight="900"
      color="#ffffff"
      letter-spacing="-1px"
      padding="0"
    >
      Abacus
    </mj-text>
  </mj-column>
  <mj-column width="40%">
    <mj-text
      css-class="header-subtitle"
      font-size="11px"
      font-weight="500"
      color="rgba(255,255,255,0.45)"
      align="right"
      padding="0"
    >
      Tu asistente fiscal<br />en WhatsApp
    </mj-text>
  </mj-column>
</mj-section>

<!-- Gold accent line -->
<mj-section background-color="#745a27" padding="0">
  <mj-column>
    <mj-divider border-width="3px" border-color="#745a27" padding="0" />
  </mj-column>
</mj-section>
