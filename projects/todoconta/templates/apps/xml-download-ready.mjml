<mjml>
  <mj-head>
    <mj-title>Tus XML están listos para descargar</mj-title>
    <mj-preview>{{contenido}} {{tipo}} listos para descargar — {{empresaNombre}}</mj-preview>

    <!-- Google Fonts: Manrope -->
    <mj-font name="Manrope" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" />

    <mj-attributes>
      <mj-all font-family="Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text font-size="15px" line-height="24px" color="#1a1a1a" padding="0" />
      <mj-section background-color="#ffffff" padding="0" />
    </mj-attributes>

    <mj-style inline="inline">
      /* Link styles */
      a {
        color: #2563eb;
        text-decoration: none;
      }
      a:hover {
        color: #1d4ed8;
        text-decoration: underline;
      }

      /* Success box */
      .success-box {
        background-color: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 8px;
        padding: 16px;
      }

      /* Data table */
      .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
      }
      .data-table td {
        padding: 8px 0;
      }
      .data-label {
        color: #6b7280;
      }
      .data-value {
        text-align: right;
        font-weight: 500;
        color: #1a1a1a;
      }
      .data-value-mono {
        text-align: right;
        font-family: monospace;
        color: #1a1a1a;
      }
      .data-value-bold {
        text-align: right;
        font-weight: 600;
        color: #1a1a1a;
      }

      /* Footer legal text */
      .footer-legal {
        font-size: 12px;
        color: #9ca3af;
        line-height: 1.6;
      }
      .footer-legal a {
        color: #9ca3af;
        text-decoration: underline;
      }
      .footer-legal a:hover {
        color: #6b7280;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f3f4f6">
    <mj-wrapper background-color="#ffffff" border-radius="16px" padding="0">

      <!-- Logo Header -->
      <mj-include path="./components/header.mjml" />

      <!-- Success Banner -->
      <mj-section padding="0 32px">
        <mj-column>
          <mj-text padding-top="8px" padding-bottom="24px">
            <div class="success-box">
              <p style="margin: 0; font-size: 15px; font-weight: 600; color: #166534;">
                Tus {{contenido}} {{tipo}} están listos para descargar
              </p>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Data Summary Table -->
      <mj-section padding="0 32px">
        <mj-column>
          <mj-text padding-bottom="24px">
            <table class="data-table">
              <tr>
                <td class="data-label">Empresa</td>
                <td class="data-value">{{empresaNombre}}</td>
              </tr>
              <tr>
                <td class="data-label">RFC</td>
                <td class="data-value-mono">{{empresaRfc}}</td>
              </tr>
              <tr>
                <td class="data-label">Periodo</td>
                <td class="data-value">{{fechaInicio}} — {{fechaFin}}</td>
              </tr>
              <tr>
                <td class="data-label">Comprobantes</td>
                <td class="data-value-bold">{{numeroCfdis}}</td>
              </tr>
            </table>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- CTA Button -->
      <mj-section padding="0 32px">
        <mj-column>
          <mj-button
            background-color="#2563eb"
            color="white"
            href="https://app.todoconta.com/descargas"
            font-size="14px"
            font-weight="500"
            padding="12px 24px"
            border-radius="6px"
            padding-bottom="32px"
          >
            Ver descargas
          </mj-button>
        </mj-column>
      </mj-section>

      <!-- Divider -->
      <mj-section padding="0 32px">
        <mj-column>
          <mj-divider border-color="#e5e7eb" border-width="1px" padding="0 0 24px 0"></mj-divider>
        </mj-column>
      </mj-section>

      <!-- Footer text -->
      <mj-section padding="0 32px">
        <mj-column>
          <mj-text font-size="12px" color="#9ca3af" align="center" padding-bottom="32px">
            TodoConta Apps · app.todoconta.com
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Footer (Reusable Component) -->
      <mj-include path="./components/footer.mjml" />

    </mj-wrapper>
  </mj-body>
</mjml>
