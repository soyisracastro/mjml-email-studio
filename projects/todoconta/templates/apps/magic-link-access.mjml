<mjml>
  <mj-head>
    <mj-title>Acceso a TodoConta</mj-title>
    <mj-preview>Haz clic para acceder a tu cuenta. El enlace expira en 1 hora.</mj-preview>

    <!-- Google Fonts: Manrope -->
    <mj-font name="Manrope" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" />

    <mj-attributes>
      <!-- Global Styles -->
      <mj-all font-family="Manrope, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" />
      <mj-text font-size="16px" line-height="26px" color="#374151" padding="0" />
      <mj-section background-color="#ffffff" padding="0" />
    </mj-attributes>

    <mj-style inline="inline">
      /* Link styles */
      a {
        color: #137fec;
        text-decoration: none;
      }
      a:hover {
        color: #0d5bb5;
        text-decoration: underline;
      }

      /* Primary button styles */
      .btn-primary {
        display: inline-block;
        background-color: #137fec;
        color: white !important;
        font-weight: 600;
        font-size: 16px;
        padding: 14px 32px;
        border-radius: 8px;
        text-decoration: none;
        text-align: center;
        transition: background-color 0.3s ease;
      }
      .btn-primary:hover {
        background-color: #0d5bb5;
        text-decoration: none;
      }

      /* Fallback link styling */
      .fallback-link {
        word-break: break-all;
        color: #137fec;
        font-size: 13px;
        line-height: 1.6;
      }

      /* Security notice styling */
      .security-notice {
        background-color: rgba(19, 127, 236, 0.08);
        border-left: 4px solid #137fec;
        padding: 16px;
        border-radius: 6px;
        font-size: 14px;
        color: #374151;
      }

      /* Footer legal text */
      .footer-legal {
        font-size: 12px;
        color: #9ca3af;
        line-height: 1.6;
      }
      .footer-legal a {
        color: #9ca3af;
        text-decoration: underline;
      }
      .footer-legal a:hover {
        color: #6b7280;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f3f4f6">
    <!-- Email Container (max-width: 600px) -->
    <mj-wrapper background-color="#ffffff" border-radius="16px" padding="0">

      <!-- Logo Header -->
      <mj-include path="./components/header.mjml" />

      <!-- Main Content Area -->
      <mj-section padding="0 32px">
        <mj-column>

          <!-- Greeting -->
          <mj-text font-size="18px" font-weight="700" color="#111418" line-height="32px" padding-top="8px" padding-bottom="24px">
            ¡Hola de nuevo!
          </mj-text>

          <!-- CTA Text -->
          <mj-text padding-bottom="32px" font-size="16px" line-height="26px">
            Haz clic en el botón para acceder a nuestras herramientas.
          </mj-text>

          <!-- Primary CTA Button -->
          <mj-button background-color="#137fec" href="{{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=magiclink" font-size="16px" font-weight="600" padding="14px 32px" border-radius="8px" padding-bottom="32px">
            Acceder a mi cuenta →
          </mj-button>

          <!-- Divider -->
          <mj-divider border-color="#e5e7eb" border-width="1px" padding="24px 0 0 0"></mj-divider>

          <!-- Fallback Link Section -->
          <mj-text padding-bottom="32px" padding-top="24px">
            <p style="margin: 0 0 12px 0; font-size: 14px; color: #374151;">O copia este enlace en tu navegador:</p>
            <p class="fallback-link" style="margin: 0;">
              <a href="{{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=magiclink">{{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=magiclink</a>
            </p>
          </mj-text>

        </mj-column>
      </mj-section>

      <!-- Security Notice Section -->
      <mj-section padding="0 32px">
        <mj-column>
          <mj-text padding="16px" padding-bottom="32px">
            <div class="security-notice">
              <p style="margin: 0; font-weight: 600; color: #111418; margin-bottom: 8px;">🔒 Este enlace expira en 1 hora</p>
              <p style="margin: 0; font-size: 13px; color: #6b7280; line-height: 1.5;">
                Por tu seguridad, el enlace es válido solo por 60 minutos. Si no accedes en ese tiempo, solicita uno nuevo.
              </p>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Non-Action Text Section -->
      <mj-section padding="0 32px">
        <mj-column>
          <mj-text padding-bottom="32px" font-size="14px" color="#6b7280">
            Si no solicitaste este acceso, puedes ignorar este mensaje de forma segura.
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Data Security Assurance -->
      <mj-section padding="0 32px">
        <mj-column>
          <mj-text padding-bottom="40px" font-size="14px" color="#6b7280">
            Tu información está 100% segura. No compartimos datos con terceros y todos los datos están encriptados.
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Footer (Reusable Component) -->
      <mj-include path="./components/footer.mjml" />

    </mj-wrapper>
  </mj-body>
</mjml>
