<mjml>
  <mj-head>
    <mj-title></mj-title>
    <mj-preview></mj-preview>

    <!-- Google Fonts: Inter -->
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />

    <mj-attributes>
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" />
      <mj-text font-size="16px" line-height="26px" color="#374151" padding="0" />
      <mj-section background-color="#ffffff" padding="0" />
    </mj-attributes>

    <mj-style inline="inline">
      a {
        color: #EF4444;
        text-decoration: none;
      }
      a:hover {
        color: #DC2626;
        text-decoration: underline;
      }

      .footer-legal {
        font-size: 12px;
        color: #9ca3af;
        line-height: 1.6;
      }
      .footer-legal a {
        color: #9ca3af;
        text-decoration: underline;
      }
      .footer-legal a:hover {
        color: #6b7280;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f3f4f6">
    <mj-wrapper background-color="#ffffff" border-radius="16px" padding="0">

      <!-- Logo Header -->
      <mj-include path="./components/header.mjml" />

      <!-- Content -->
      <mj-section padding="0 32px">
        <mj-column>

          <mj-text padding-bottom="24px">
            <!-- Your content here -->
          </mj-text>

        </mj-column>
      </mj-section>

      <!-- Footer -->
      <mj-include path="./components/footer.mjml" />

    </mj-wrapper>
  </mj-body>
</mjml>
