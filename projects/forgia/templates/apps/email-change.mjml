<mjml>
  <mj-head>
    <mj-title>Confirma tu nuevo email en Forgia</mj-title>
    <mj-preview>Solicitaste cambiar el email de tu cuenta. Haz clic para confirmar tu nuevo email.</mj-preview>

    <!-- Google Fonts: Inter -->
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />

    <mj-attributes>
      <!-- Global Styles -->
      <mj-all font-family="Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" />
      <mj-text font-size="16px" line-height="26px" color="#374151" padding="0" />
      <mj-section background-color="#ffffff" padding="0" />
    </mj-attributes>

    <mj-style inline="inline">
      /* Link styles */
      a {
        color: #EF4444;
        text-decoration: none;
      }
      a:hover {
        color: #DC2626;
        text-decoration: underline;
      }

      /* Primary button styles */
      .btn-primary {
        display: inline-block;
        background-color: #EF4444;
        color: white !important;
        font-weight: 600;
        font-size: 16px;
        padding: 14px 32px;
        border-radius: 8px;
        text-decoration: none;
        text-align: center;
        transition: background-color 0.3s ease;
      }
      .btn-primary:hover {
        background-color: #DC2626;
        text-decoration: none;
      }

      /* Fallback link styling */
      .fallback-link {
        word-break: break-all;
        color: #EF4444;
        font-size: 13px;
        line-height: 1.6;
      }

      /* Security notice styling */
      .security-notice {
        background-color: rgba(239, 68, 68, 0.08);
        border-left: 4px solid #EF4444;
        padding: 16px;
        border-radius: 6px;
        font-size: 14px;
        color: #374151;
      }

      /* Warning notice styling */
      .warning-notice {
        background-color: rgba(249, 115, 22, 0.08);
        border-left: 4px solid #F97316;
        padding: 16px;
        border-radius: 6px;
        font-size: 14px;
        color: #374151;
      }

      /* Footer legal text */
      .footer-legal {
        font-size: 12px;
        color: #9ca3af;
        line-height: 1.6;
      }
      .footer-legal a {
        color: #9ca3af;
        text-decoration: underline;
      }
      .footer-legal a:hover {
        color: #6b7280;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f3f4f6">
    <!-- Email Container (max-width: 600px) -->
    <mj-wrapper background-color="#ffffff" border-radius="16px" padding="0">

      <!-- Logo Header -->
      <mj-include path="./components/header.mjml" />

      <!-- Main Content Area -->
      <mj-section padding="0 32px">
        <mj-column>

          <!-- Greeting -->
          <mj-text font-size="18px" font-weight="700" color="#171717" line-height="32px" padding-top="8px" padding-bottom="24px">
            Hola,
          </mj-text>

          <!-- Main Message -->
          <mj-text padding-bottom="8px" font-size="16px" line-height="26px" font-weight="600">
            Solicitaste cambiar el email de tu cuenta en Forgia.
          </mj-text>

          <!-- CTA Text -->
          <mj-text padding-bottom="32px" font-size="15px" line-height="26px" color="#6b7280">
            Haz clic en el botón para confirmar tu nuevo email:
          </mj-text>

          <!-- Primary CTA Button -->
          <mj-button background-color="#EF4444" href="{{ .ConfirmationURL }}" font-size="16px" font-weight="600" padding="14px 32px" border-radius="8px" padding-bottom="32px">
            Confirmar nuevo email →
          </mj-button>

          <!-- Divider -->
          <mj-divider border-color="#e5e5e5" border-width="1px" padding="24px 0 0 0"></mj-divider>

          <!-- Fallback Link Section -->
          <mj-text padding-bottom="32px" padding-top="24px">
            <p style="margin: 0 0 12px 0; font-size: 14px; color: #374151;">O copia este enlace en tu navegador:</p>
            <p class="fallback-link" style="margin: 0;">
              <a href="{{ .ConfirmationURL }}">{{ .ConfirmationURL }}</a>
            </p>
          </mj-text>

        </mj-column>
      </mj-section>

      <!-- Expiration Info Section -->
      <mj-section padding="0 32px">
        <mj-column>
          <mj-text padding="16px" padding-bottom="32px">
            <div class="security-notice">
              <p style="margin: 0; font-weight: 600; color: #171717; margin-bottom: 8px;">⏰ Este enlace expira en 24 horas</p>
              <p style="margin: 0; font-size: 13px; color: #6b7280; line-height: 1.5;">
                Por tu seguridad, el enlace es válido solo por 24 horas. Si no confirmas en ese tiempo, deberás solicitar el cambio nuevamente.
              </p>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Security Warning Section -->
      <mj-section padding="0 32px">
        <mj-column>
          <mj-text padding="16px" padding-bottom="40px">
            <div class="warning-notice">
              <p style="margin: 0; font-weight: 600; color: #ea580c; margin-bottom: 8px;">⚠️ ¿No solicitaste este cambio?</p>
              <p style="margin: 0; font-size: 13px; color: #374151; line-height: 1.5;">
                Si no solicitaste este cambio, ignora este email y tu cuenta permanecerá sin cambios. Tu información está segura.
              </p>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Footer (Reusable Component) -->
      <mj-include path="./components/footer.mjml" />

    </mj-wrapper>
  </mj-body>
</mjml>
